# ---------------------------------------------------------------------------
# Configuración del chatbot — copia a .env y ajusta (cp .env.example .env).
# docker-compose inyecta defaults; .env solo hace falta para overrides.
# Todas las variables: app/core/config.py
# ---------------------------------------------------------------------------

# --- LLM (orquestador del agente) -------------------------------------------
# mock   = modo demo SIN clave: el flujo completo (retrieval + citas) funciona
#          pero sin razonamiento del LLM.
# openai = cualquier API compatible con /v1/chat/completions (OpenAI, Groq,
#          OpenRouter, vLLM, Ollama...). Requiere LLM_API_KEY.
LLM_PROVIDER=openai
LLM_BASE_URL=.........
LLM_API_KEY=.......
LLM_MODEL=......
LLM_TEMPERATURE=0.1

# --- Embeddings ---------------------------------------------------------------
# local  = sentence-transformers dentro del contenedor (descarga ~470 MB la
#          primera vez; se cachea en el volumen hf-cache). Multilingüe por
#          defecto: preguntas en español, reglamento en inglés.
# openai = API de embeddings (reutiliza LLM_API_KEY si no defines EMBEDDING_API_KEY).
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL=intfloat/multilingual-e5-small
#EMBEDDING_API_KEY=
#EMBEDDING_BASE_URL=https://api.openai.com/v1
# Prefijos de la familia e5 (query/passage). Para otros modelos déjalos vacíos.
EMBEDDING_QUERY_PREFIX="query: "
EMBEDDING_PASSAGE_PREFIX="passage: "

# --- Retrieval (ChromaDB) -----------------------------------------------------
RETRIEVAL_TOP_K=6
# Distancia coseno máxima para considerar un chunk relevante. Por encima, la
# respuesta es honesta ("no encontré base en el reglamento") en vez de alucinar.
# Calibrado con: docker compose --profile tools run --rm eval
RETRIEVAL_MAX_DISTANCE=0.95

# --- Sesión / caché (Redis) ---------------------------------------------------
# La app en docker-compose usa redis://redis:6379/0 automáticamente.
# Sin Docker puedes usar REDIS_URL=memory:// (almacén en proceso, sin persistencia).
#REDIS_URL=redis://localhost:6379/0
HISTORY_MAX_MESSAGES=20

# --- App ----------------------------------------------------------------------
LOG_LEVEL=INFO
ENVIRONMENT=dev

# --- Observabilidad LLM (Langfuse) --------------------------------------------
# false por defecto (la app funciona sin Langfuse). Para activar:
# 1) self-host:  docker compose --profile observability up -d
#    -> regístrate en http://localhost:3000, crea claves de API de la org
#    -> LANGFUSE_HOST=http://langfuse-web:3000 (red interna de compose)
# 2) o Langfuse Cloud (https://cloud.langfuse.com) con LANGFUSE_HOST=https://cloud.langfuse.com
# Cada llamada al LLM queda trazada (prompt, tools, tokens, coste, latencia).
LANGFUSE_ENABLED=false
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
# Dentro de docker-compose: http://langfuse-web:3000 | local: http://localhost:3000
#LANGFUSE_HOST=http://langfuse-web:3000

# --- Doble juez LLM (promptfoojudges.yaml) ------------------------------------
# Dos jueces evalúan cada respuesta con la misma rúbrica; un test solo pasa si
# AMBOS aprueban (consenso). Defaults con tu OPENAI_API_KEY; el valor máximo
# está en cruzar familias de modelos:
#   JUDGE_2=anthropic:claude-sonnet-4-5   (+ ANTHROPIC_API_KEY)
#   JUDGE_2=groq:llama-3.3-70b-versatile (+ GROQ_API_KEY)
JUDGE_1=openai:gpt-4o-mini
JUDGE_2=openai:gpt-4o
